# ─────────────────────────────────────────────────────────────────────────────
# Pokémon Restock Monitor (Amazon México) — entorno de ejemplo.
# Copia a .env para correr en el PC. NUNCA commitees un .env real.
# En GitHub Actions estas claves van como Secrets del repo (ver README).
# ─────────────────────────────────────────────────────────────────────────────

# Identidad del runner: "pc" (Task Scheduler) o "actions" (GitHub Actions).
RUNNER_ID=pc

# ── Discord (mismo bot del Alert, canal NUEVO) ──
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Rol a mencionar en restocks/pre-órdenes (opcional).
DISCORD_MENTION_ROLE_ID=
# Alternativa sin bot: webhook del canal (se usa solo si no hay token+canal).
DISCORD_WEBHOOK_URL=

# Localmente SEND_DISCORD arranca en false (dry-run). run-monitor.cmd lo pone en true.
SEND_DISCORD=false
MENTION_ON_IN_STOCK=true
MENTION_ON_PREORDER=true
NOTIFY_ON_DISCOVERY=false
SEND_DAILY_HEARTBEAT=false

# Si al arrancar un producto YA está en stock por Amazon México, ¿avisar? (true recomendado)
ALERT_ON_FIRST_OBSERVATION=true
# Minutos mínimos entre alertas del mismo ASIN (anti-flapping).
ALERT_COOLDOWN_MIN=30

# ── Scraping ──
# playwright | static | auto. Playwright por defecto: el fetch plano de Node recibe
# el robot-check de Amazon / interstitial de Akamai incluso desde IP residencial
# (verificado 2026-10-10); un Chromium real recibe la página completa.
FETCH_MODE=playwright
# Solo para FETCH_MODE=static/auto: chrome (headers completos) | minimal (UA/Accept/Accept-Language)
HEADER_PROFILE=chrome
# Páginas por corrida (1 búsqueda + prioridad 1 + round-robin + 1 de reserva). PC: 10, Actions: 5.
MAX_REQUESTS_PER_RUN=10
JITTER_MIN_MS=2000
JITTER_MAX_MS=5000
RUN_DEADLINE_MS=390000
FETCH_TIMEOUT_MS=20000
RENDER_TIMEOUT_MS=45000
SAVE_DEBUG_HTML=false

# ── Tareas periódicas ──
DISCOVERY_INTERVAL_MIN=60
STORE_SWEEP_ENABLED=true
STORE_SWEEP_INTERVAL_MIN=1440
STORE_SWEEP_HOURS=09-22

# ── Failover PC ↔ Actions (solo relevante en Actions) ──
DEFER_TO_PC=false
PC_FRESH_MINUTES=25
WATCHDOG_STALE_MINUTES=45

# ── Estado compartido ──
# auto = gist si hay GIST_ID+GIST_TOKEN; si no, artifact en Actions o archivo local en el PC.
STATE_BACKEND=auto
GIST_ID=
# PAT CLÁSICO con único scope "gist" (los fine-grained no acceden a gists).
GIST_TOKEN=
STATE_FILE=state/shared.json
RUNNER_STATE_FILE=state/runner-pc.json
ARTIFACT_NAME=pokemon-restock-shared-state

# ── Varios ──
WATCHLIST_FILE=watchlist.json
TIMEZONE=America/Mexico_City
LOG_LEVEL=info
LOG_PRETTY=true

# ── Depuración ──
# ONLY_ASIN=B0H8SV3WJ8
# FORCE_RUN=true
# MOCK_HTML_DIR=test/mock
# SIMULATE=B0H8SV3WJ8=out_of_stock
